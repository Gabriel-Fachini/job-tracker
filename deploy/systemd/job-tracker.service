[Unit]
Description=Job Tracker (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=jobtracker
Group=jobtracker
WorkingDirectory=/srv/job-tracker/current
EnvironmentFile=/etc/job-tracker/env
ExecStart=/srv/job-tracker/current/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
