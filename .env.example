# Database
DATABASE_URL=./job-tracker.db

# OpenAI
OPENAI_API_KEY=
# Profile extraction from the PDF
OPENAI_COMPARISON_MODEL=gpt-6-sol
# Radar description formatting (opt-in) and its model (reasoning: none)
OPENAI_FORMAT_JOB_DESCRIPTIONS=false
OPENAI_FORMAT_MODEL=gpt-6-luna
# Triage (stages 1 and 2 of the radar): gpt-6-luna, reasoning "none", strict structured output
OPENAI_TRIAGE_MODEL=gpt-6-luna
# Generation (English resume selection, cover letter, free-text drafts, "Formatar"): gpt-6-sol, reasoning "low"
OPENAI_GENERATION_MODEL=gpt-6-sol

# Which engine answers: openai (default) | jev | ollama
TRIAGE_ENGINE=openai
GENERATION_ENGINE=openai

# TypeSafe (Jev): only when TRIAGE_ENGINE=jev.
# TYPESAFE_BASE_URL points at any server with the same POST /v1/systemone contract, e.g. a
# self-hosted Jev-compatible laya-serve (http://127.0.0.1:8000); the key is then optional.
# On the official host (api.typesafe.ai) the key is required.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Token budget (characters / 4) of the state sent to the triage models. Self-hosted checkpoints
# read about 768-4000 tokens reliably: lower it there.
TRIAGE_MAX_STATE_TOKENS=6000

# Ollama runtime
OLLAMA_RUNTIME_MODE=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=240000

# Glassdoor import (machine endpoints /api/glassdoor/*). Empty = endpoints answer 503.
# Generate with: openssl rand -hex 32
GLASSDOOR_IMPORT_TOKEN=

# Local storage
UPLOADS_PATH=./uploads

# Optional sample resume identity overrides used by `npm run resume:sample`
SAMPLE_PROFILE_FULL_NAME=
SAMPLE_PROFILE_EMAIL=
SAMPLE_PROFILE_PHONE=
SAMPLE_PROFILE_LINKEDIN=
SAMPLE_PROFILE_GITHUB=
SAMPLE_PROFILE_LOCATION=
